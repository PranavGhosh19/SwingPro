{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based attributes for Clubs and Golfers",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["club", "golfer"] },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "clubName": { "type": "string" },
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "badges": { "type": "array", "items": { "type": "string" } },
        "streaks": {
          "type": "object",
          "properties": {
            "weeksActive": { "type": "number" },
            "challengesJoined": { "type": "number" }
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "longestDrive": { "type": "number" },
            "totalBirdies": { "type": "number" },
            "bestRound": { "type": "number" }
          }
        }
      },
      "required": ["fullName", "email", "role"]
    },
    "Round": {
      "title": "Round",
      "description": "Comprehensive golf round performance data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "courseName": { "type": "string" },
        "courseRating": { "type": "number" },
        "slopeRating": { "type": "number" },
        "par": { "type": "number" },
        "grossScore": { "type": "number" },
        "puttsPerRound": { "type": "number" },
        "fairwaysHitPercentage": { "type": "number" },
        "girPercentage": { "type": "number" },
        "scramblingPercentage": { "type": "number" },
        "threePuttPercentage": { "type": "number" },
        "missDirection": { "type": "string", "enum": ["left", "right", "straight", "N/A"] },
        "strokesGained": {
          "type": "object",
          "properties": {
            "tee": { "type": "number" },
            "approach": { "type": "number" },
            "short": { "type": "number" },
            "putting": { "type": "number" }
          }
        }
      },
      "required": ["date", "courseName", "grossScore", "par"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Root user profile document"
    },
    "/users/{userId}/rounds/{roundId}": {
      "schema": "Round",
      "description": "Collection of golf rounds for a specific user"
    }
  }
}