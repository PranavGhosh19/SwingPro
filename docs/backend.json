
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based attributes for Clubs and Golfers",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["club", "golfer"] },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "clubName": { "type": "string" },
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "badges": { "type": "array", "items": { "type": "string" } },
        "metrics": {
          "type": "object",
          "properties": {
            "longestDrive": { "type": "number" },
            "totalBirdies": { "type": "number" },
            "bestRound": { "type": "number" }
          }
        }
      },
      "required": ["fullName", "email", "role"]
    },
    "Course": {
      "title": "Course",
      "description": "Golf course configuration and tee data",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "location": { "type": "string" },
        "tees": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "color": { "type": "string" },
              "rating": { "type": "number" },
              "slope": { "type": "number" },
              "par": { "type": "number" }
            }
          }
        }
      }
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Club-hosted tournament event",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "clubId": { "type": "string" },
        "format": { "type": "string", "enum": ["stroke", "stableford", "match", "scramble"] },
        "status": { "type": "string", "enum": ["upcoming", "active", "completed"] },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "participants": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Round": {
      "title": "Round",
      "description": "Golf round performance data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "tournamentId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "courseName": { "type": "string" },
        "grossScore": { "type": "number" },
        "putts": { "type": "number" },
        "gir": { "type": "number" },
        "fir": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Root user profile"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Course infrastructure data"
    },
    "/tournaments/{tournamentId}": {
      "schema": "Tournament",
      "description": "Active and archived tournaments"
    },
    "/users/{userId}/rounds/{roundId}": {
      "schema": "Round",
      "description": "Player performance history"
    }
  }
}
