rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User Profile Rules: Users can only read and write their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Golf Rounds Rules: Users can only manage rounds within their own sub-collection.
      match /rounds/{roundId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Default deny for any other path.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}